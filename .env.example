# Copier ce fichier en .env puis remplir les valeurs.
# Le fichier .env n'est jamais versionne. Voir docs/commandes/01-installation-mac.md

# Base de donnees
POSTGRES_USER=commande_publique
POSTGRES_PASSWORD=a_changer
POSTGRES_DB=commande_publique
POSTGRES_HOST=localhost
# Port 55432 et non 5432 : le 11 octobre 2026, un PostgreSQL deja installe sur le Mac occupait
# le port standard. La connexion tombait sur ce serveur-la, avec une erreur trompeuse
# (« role does not exist ») alors que le conteneur fonctionnait parfaitement.
# Le conteneur ecoute toujours sur 5432 a l'interieur ; seul le port cote machine change.
POSTGRES_PORT=55432

# API publique
API_HOST=0.0.0.0
API_PORT=8000

# Environnement d'execution : local, vps
ENVIRONNEMENT=local
