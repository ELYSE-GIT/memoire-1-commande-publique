# Copier ce fichier en .env puis remplir les valeurs.
# Le fichier .env n'est jamais versionne. Voir docs/commandes/01-installation-mac.md

# Base de donnees
POSTGRES_USER=commande_publique
POSTGRES_PASSWORD=a_changer
POSTGRES_DB=commande_publique
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API publique
API_HOST=0.0.0.0
API_PORT=8000

# Environnement d'execution : local, vps
ENVIRONNEMENT=local
